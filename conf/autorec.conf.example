# 録画先ディレクトリ (新規録画はここに書き込む)
RECORD_DIR="/mnt/data"
# 再生対象の追加ディレクトリ (Web UI が録画済みを読み込む旧ディスク等。コロン区切り。
# RECORD_DIR は常に自動で含まれるので、追加ルートのみ列挙すればよい。例: PLAYBACK_DIRS="/mnt/dataa:/mnt/datac")
PLAYBACK_DIRS=""
# 録画開始オフセット (番組開始の何秒前に録画開始するか)
START_OFFSET=1
# 録画終了オフセット (番組終了の何秒後に録画停止するか)
END_OFFSET=0
# 通知 (空欄で無効)
DISCORD_WEBHOOK=""
LINE_NOTIFY_TOKEN=""
# Web UIポート
WEB_PORT=8080
# DBパス
EPG_DB="$AUTOREC_DIR/db/epg.sqlite"
AUTOREC_DB="$AUTOREC_DIR/db/autorec.sqlite"
# HLS 配信 (iOS アプリ向け) のテンポラリディレクトリと挙動
HLS_TMP_DIR="/tmp/autorec-hls"
HLS_IDLE_TIMEOUT=30
HLS_LIVE_SEGMENT_DURATION=2
HLS_VOD_SEGMENT_DURATION=6
